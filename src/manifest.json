{
  "manifest_version": 3,
  "name": "Darkit",
  "description": "Auto dark mode for sites that don't have one.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle dark mode for this tab" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["dark.css"],
      "js": ["detect.js"],
      "run_at": "document_idle"
    }
  ]
}
