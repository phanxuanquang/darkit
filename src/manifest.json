{
  "manifest_version": 3,
  "name": "Darkit",
  "description": "Dark mode for every website. Uses the site's own dark theme when it has one, a reading-friendly filter when it doesn't.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle dark mode for this tab",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["dark.css"],
      "js": ["detect.js"],
      "run_at": "document_idle"
    }
  ]
}
